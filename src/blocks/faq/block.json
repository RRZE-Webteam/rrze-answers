{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rrze-answers/faq",
	"version": "6.0.0",
	"title": "RRZE FAQ",
	"category": "rrze",
	"description": "Display FAQ",
	"icon": "editor-help",
	"example": {},
	"attributes": {
		"glossary": {
			"type": "string",
			"default": ""
		},
		"glossarystyle": {
			"type": "string",
			"default": ""
		},
		"category": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"tag": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"id": {
			"type": "array",
			"items": {
				"type": "integer"
			},
			"default": []
		},
		"hide_accordion": {
			"type": "boolean",
			"default": false
		},
		"hide_title": {
			"type": "boolean",
			"default": false
		},
		"masonry": {
			"type": "boolean",
			"default": false
		},
		"search": {
			"type": "boolean",
			"default": false
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": "light"
		},
		"additional_class": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"sort": {
			"type": "string",
			"default": "title"
		},
		"order": {
			"type": "string",
			"default": "ASC"
		},
		"hstart": {
			"type": "number",
			"default": 2
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "rrze-answers",
	"editorScript": [
		"file:./index.js",
		"rrze-answers-accordion",
		"rrze-answers-search"
	],
	"editorStyle": "rrze-answers-css",
	"render": "file:./render.php"
}
