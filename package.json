{
	"name": "rrze-answers",
	"version": "1.4.7",
	"description": "Explain your content with FAQ, glossary, synonyms and placeholder.",
	"author": "RRZE Webteam",
	"license": "GPL-2.0-or-later",
	"textdomain": "rrze-answers",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"start": "npm run build:css && npm-run-all --parallel start:js start:css",
		"start:js": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"start:css": "sass src/sass:build/css --style expanded --source-map --watch",
		"build": "npm-run-all build:js build:css check:build",
		"build:js": "wp-scripts build --webpack-copy-php --blocks-manifest && node scripts/normalize-block-manifest.js",
		"build:css": "sass src/sass:build/css --style compressed --no-source-map",
		"check:build": "node scripts/validate-block-build.js",
		"increment-version": "node increment-version.js patch",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js --resolve-plugins-relative-to ./node_modules/@wordpress/eslint-plugin",
		"lint:js:fix": "wp-scripts lint-js --resolve-plugins-relative-to ./node_modules/@wordpress/eslint-plugin --fix",
		"typecheck": "tsc --noEmit",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js",
		"i18n:make-pot": "wp i18n make-pot build/ languages/rrze-answers.pot",
		"i18n:make-json": "wp i18n make-json build/ --no-purge",
		"version:patch": "npm version patch && npm run i18n:make-pot && npm run i18n:make-json",
		"version:prerelease": "npm version prerelease && npm run i18n:make-pot && npm run i18n:make-json"
	},
	"devDependencies": {
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/api-fetch": "^7.54.0",
		"@wordpress/block-editor": "^17.0.0",
		"@wordpress/blocks": "^15.27.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/data": "^10.54.0",
		"@wordpress/i18n": "^5.9.0",
		"@wordpress/rich-text": "^7.54.0",
		"@wordpress/scripts": "^30.7.0",
		"@wordpress/server-side-render": "^6.30.0",
		"jest": "^29.7.0",
		"jest-puppeteer": "^11.0.0",
		"npm-run-all": "^4.1.5",
		"sass": "^1.87.0",
		"stylelint": "^16.19.1",
		"stylelint-config-recommended": "^16.0.0",
		"stylelint-config-standard": "^38.0.0",
		"typescript": "~5.9.3"
	}
}
