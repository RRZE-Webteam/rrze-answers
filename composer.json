{
  "name": "rrze/rrze-answers",
  "description": "FAQ, glossary, synonym and placeholder management for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "RRZE\\Answers\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RRZE\\Answers\\Tests\\": "tests/phpunit/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "check": [
      "@test",
      "@phpstan"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the WordPress PHPUnit integration tests",
    "phpstan": "Run static analysis with WordPress type support",
    "check": "Run all PHP quality checks"
  }
}
